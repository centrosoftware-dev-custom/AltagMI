package PI_AltagMI_SelLottiSpecDDT;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Selezione lotti specifici in DDT per articolo generico'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  CSApplication;

contains
  USelLottiSpecDDT in 'USelLottiSpecDDT.pas',
  frmSelLottiSpec in 'frmSelLottiSpec.pas' {FSelLottiSpec},
  UVarieLottiSpec in 'UVarieLottiSpec.pas';

  {$SetPEFlags $0800}
end.
